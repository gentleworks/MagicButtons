# Per-signer config for scripts/release.sh — copy to release.local.env and fill in.
# release.local.env is gitignored: your Developer ID never lands in the repo.
#
# Find your identity string with:  security find-identity -p codesigning -v
#   (use the full "Developer ID Application: <Name> (<TEAMID>)" line)

MB_SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"
MB_TEAM_ID="TEAMID"

# ── Codeberg Release (only needed for `release.sh --publish`) ──────────────────
# --publish mirrors each Sparkle build to a Codeberg Release (git tag + notes + DMG)
# so the hand-download matches the auto-updater. Create a token with the
# repository:write scope at https://codeberg.org/user/settings/applications.
# If MB_CODEBERG_TOKEN is unset, the Release step is skipped (Pages still publishes).
MB_CODEBERG_TOKEN=""
# Override only if the repo path differs from the default anguiano/MagicButtons:
# MB_CODEBERG_REPO="anguiano/MagicButtons"
