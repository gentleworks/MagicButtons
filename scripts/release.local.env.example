# Per-signer config for scripts/release.sh — copy to release.local.env and fill in.
# release.local.env is gitignored: your Developer ID never lands in the repo.
#
# Find your identity string with:  security find-identity -p codesigning -v
#   (use the full "Developer ID Application: <Name> (<TEAMID>)" line)

MB_SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"
MB_TEAM_ID="TEAMID"
