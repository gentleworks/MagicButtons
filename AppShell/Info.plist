<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>MagicButtons</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<!-- Menu-bar accessory: no Dock icon, no default window (docs/07 §App shape). -->
	<key>LSUIElement</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 Paul Anguiano. MIT-licensed.</string>
	<!--
	  Sparkle auto-updater (docs/07 §Distribution, docs/14 §Sparkle). We distribute a
	  signed/notarized DMG outside the App Store, so updates ship via an EdDSA-signed
	  appcast hosted on Codeberg Pages. SUEnableAutomaticChecks is intentionally omitted
	  so Sparkle shows its standard one-time "check automatically?" consent prompt on the
	  second launch and honors the user's choice (docs/14 — decided: automatic + manual).
	-->
	<key>SUFeedURL</key>
	<string>https://anguiano.codeberg.page/MagicButtons/appcast.xml</string>
	<!-- EdDSA public key (generated by Sparkle's `generate_keys`, S2). The matching
	     PRIVATE key lives only in this developer's login Keychain (never committed —
	     see .gitignore); the release pipeline signs the appcast with it. Sparkle refuses
	     unsigned updates, so this must stay in sync with the signing key. -->
	<key>SUPublicEDKey</key>
	<string>P7c0kjIvG8mKtdfOtjbid2K49eJ9DXAqjzBaP18416o=</string>
	<!--
	  Accessibility is the one TCC grant this app needs (docs/07; Input Monitoring was
	  dropped in Phase 9 — it doesn't gate the multitouch stream, docs/08). It isn't
	  gated by an NS*UsageDescription Info.plist key — its authorization prompt is
	  system-provided. The user-facing rationale + one-tap fix is handled in-app
	  (menu-bar "Fix …" item and the Settings permission list, deep-linking to the
	  exact pane), not via purpose strings.
	-->
</dict>
</plist>
