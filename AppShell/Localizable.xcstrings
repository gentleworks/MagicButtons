{
  "sourceLanguage": "en",
  "strings": {
    "About MagicButtons": {
      "comment": "About window title. 'MagicButtons' is the app name — do not translate.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acerca de MagicButtons"
          }
        }
      }
    },
    "Accessibility granted, but clicks aren’t posting": {
      "comment": "Menu status line: permission is present but the event tap failed.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesibilidad concedida, pero los clics no se envían"
          }
        }
      }
    },
    "Accessibility was granted while MagicButtons was running — Quit & Reopen to finish enabling clicks.": {
      "comment": "Status pane, Recent issue. 'MagicButtons' is the app name — do not translate.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se concedió Accesibilidad mientras MagicButtons estaba en marcha. Sal y vuelve a abrir la app para terminar de activar los clics."
          }
        }
      }
    },
    "Accessibility was granted while MagicButtons was running. Relaunch so clicks start posting.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se concedió Accesibilidad mientras MagicButtons estaba en marcha. Reinicia la app para que empiecen a enviarse los clics."
          }
        }
      }
    },
    "Active": {
      "comment": "Menu status line: running normally.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activo"
          }
        }
      }
    },
    "Advanced": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avanzado"
          }
        }
      }
    },
    "All features available.": {
      "comment": "Features pane header: every capability is working.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las funciones están disponibles."
          }
        }
      }
    },
    "Backend": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Backend"
          }
        }
      }
    },
    "Backend ready — no frames yet (touch the mouse to confirm).": {
      "comment": "Status pane, Backend row: connected but no frames seen yet.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Backend listo: aún no hay fotogramas (toca el ratón para confirmarlo)."
          }
        }
      }
    },
    "Buttons": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Botones"
          }
        }
      }
    },
    "Check for Updates…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscar actualizaciones…"
          }
        }
      }
    },
    "Couldn’t create a log in %@.": {
      "comment": "Error note when the diagnostics log file couldn't be opened. %@ is a folder path.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo crear un registro en %@."
          }
        }
      }
    },
    "Couldn’t export settings": {
      "comment": "Alert title when writing the settings JSON failed.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron exportar los ajustes"
          }
        }
      }
    },
    "Couldn’t import settings": {
      "comment": "Alert title when reading the settings JSON failed.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron importar los ajustes"
          }
        }
      }
    },
    "Couldn’t install the event tap — grant Accessibility so clicks can post.": {
      "comment": "Status pane, Recent issue: the CGEvent tap failed to install.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo instalar el interceptor de eventos. Concede Accesibilidad para que se envíen los clics."
          }
        }
      }
    },
    "Couldn’t turn off Open at Login: %@": {
      "comment": "Error note when unregistering the login item failed.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo desactivar «Abrir al iniciar sesión»: %@"
          }
        }
      }
    },
    "Couldn’t turn on Open at Login: %@": {
      "comment": "Error note when registering the login item failed.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo activar «Abrir al iniciar sesión»: %@"
          }
        }
      }
    },
