    "Open at Login": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir al iniciar sesión"
          }
        }
      }
    },
    "Permissions": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permisos"
          }
        }
      }
    },
    "Physically click while your finger is in the middle zone to emit a middle click.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic físicamente con el dedo en la zona central para enviar un clic central."
          }
        }
      }
    },
    "Press and hold": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener pulsado"
          }
        }
      }
    },
    "Quit & Reopen MagicButtons": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salir y volver a abrir MagicButtons"
          }
        }
      }
    },
    "Quit & Reopen to Finish Setup": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salir y volver a abrir para terminar la configuración"
          }
        }
      }
    },
    "Quit & Reopen to finish setup": {
      "comment": "Menu status line: a relaunch is needed to apply a new grant.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sal y vuelve a abrir para terminar la configuración"
          }
        }
      }
    },
    "Quit MagicButtons": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salir de MagicButtons"
          }
        }
      }
    },
    "Recent issue": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Problema reciente"
          }
        }
      }
    },
    "Record a troubleshooting log": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabar un registro de diagnóstico"
          }
        }
      }
    },
    "Recording stopped automatically after %lld minutes.": {
      "comment": "Why a diagnostics recording ended on its own (time limit).",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Recording stopped automatically after %lld minute."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Recording stopped automatically after %lld minutes."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "La grabación se detuvo automáticamente después de %lld minuto."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "La grabación se detuvo automáticamente después de %lld minutos."
                }
              }
            }
          }
        }
      }
    },
    "Recording stopped automatically — the log reached %lld MB.": {
      "comment": "Why a diagnostics recording ended on its own (size limit). MB = megabytes.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación se detuvo automáticamente: el registro alcanzó %lld MB."
          }
        }
      }
    },
    "Recording — reproduce the problem, then turn this off and attach the log to your bug report.": {
      "comment": "Troubleshooting help while recording, with no auto-stop time known.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabando: reproduce el problema, después desactiva esto y adjunta el registro a tu informe de error."
          }
        }
      }
    },
    "Recording — reproduce the problem, then turn this off and attach the log to your bug report. Stops on its own at %@.": {
      "comment": "Troubleshooting help while recording; %@ is a locale-formatted clock time.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabando: reproduce el problema, después desactiva esto y adjunta el registro a tu informe de error. Se detendrá automáticamente a las %@."
          }
        }
      }
    },
    "Reset to Defaults": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restablecer los valores por omisión"
          }
        }
      }
    },
    "Reveal in Finder…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar en el Finder…"
          }
        }
      }
    },
    "Right edge": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borde derecho"
          }
        }
      }
    },
    "Settings file": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivo de ajustes"
          }
        }
      }
    },
    "Settings…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes…"
          }
        }
      }
    },
    "Status": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estado"
          }
        }
      }
    },
    "Tap the left or right zone to click that button.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca la zona izquierda o derecha para hacer clic con ese botón."
          }
        }
      }
    },
    "Tap the middle zone to emit a middle click.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca la zona central para enviar un clic central."
          }
        }
      }
    },
    "Tap to click": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocar para hacer clic"
          }
        }
      }
    },
    "Tap, then press and hold a second time and move the mouse to drag. Deliberate and familiar from the trackpad; a drag on text starts by selecting the word under the pointer. Fingers can rest on the shell.": {
      "comment": "Explainer under the Drag style picker for the tap-and-a-half option.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca y, a continuación, mantén pulsado por segunda vez y mueve el ratón para arrastrar. Es deliberado y resulta familiar por el trackpad; al arrastrar sobre texto se empieza seleccionando la palabra bajo el puntero. Puedes apoyar los dedos en la carcasa."
          }
        }
      }
    },
    "Tap-and-a-half": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque y medio"
          }
        }
      }
    },
    "The Magic Mouse is connected but no touches are arriving, and reconnecting didn’t help — Quit & Reopen MagicButtons.": {
      "comment": "Status pane, Recent issue: the deaf-stream case. Product/app names — do not translate.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Magic Mouse está conectado pero no llegan toques, y volver a conectarlo no ha servido. Sal y vuelve a abrir MagicButtons."
          }
        }
      }
    },
    "The log records which zone your finger touches, the gestures recognized, and their timings. It never records text, cursor positions, or key presses.": {
      "comment": "Troubleshooting section footer stating what the log does and doesn't capture.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El registro guarda qué zona toca tu dedo, los gestos reconocidos y sus tiempos. Nunca guarda texto, posiciones del cursor ni pulsaciones de teclas."
          }
        }
      }
    },
    "The multitouch backend didn’t load on this macOS build. An update to MagicButtons may be required.": {
      "comment": "Status pane, Recent issue. 'MagicButtons' is the app name — do not translate.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El backend multitáctil no se cargó en esta versión de macOS. Puede que sea necesario actualizar MagicButtons."
          }
        }
      }
    },
    "The multitouch backend is unavailable on this macOS build.": {
      "comment": "Status pane, Recent issue: backend missing on this OS build.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
