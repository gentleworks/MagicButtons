# macOS
.DS_Store
._*
.AppleDouble
.LSOverride
Icon?
.Spotlight-V100
.Trashes

# Swift Package Manager
.build/
.swiftpm/
# Package.resolved is intentionally committed: for a distributable app it pins
# exact dependency versions for reproducible builds.

# Xcode
*.xcuserstate
xcuserdata/
DerivedData/
build/
*.xcscmblueprint
*.xccheckout
*.hmap
*.xctimeline

# XcodeGen output — generated from project.yml (the committed source of truth).
# Regenerate with `xcodegen generate`; see README "Building from source".
*.xcodeproj
*.xcworkspace

# Build / debug artifacts
*.dSYM
*.dSYM.zip
*.ipa
*.app

# Signing / secrets (never commit)
*.p12
*.cer
*.pem
*.provisionprofile
*.mobileprovision
ExportOptions.plist

# App Store Connect / notarization keys (never commit)
*.p8
AuthKey_*.p8

# Sparkle update signing — EdDSA PRIVATE key must never be committed
# (public key belongs in Info.plist; keep the private key in Keychain).
*_priv.pem
sparkle_priv*
dsa_priv*

# Environment / local config (may hold DEVELOPMENT_TEAM, credentials)
.env
.env.*
.envrc
*.local.xcconfig
scripts/release.local.env

# Notarization / distribution artifacts
*.dmg
*.zip

# Editors / tooling
.vscode/
.idea/
*.swp
*~

# Claude Code local (machine-specific paths & permissions)
.claude/settings.local.json
CLAUDE.local.md

# Logs
*.log

# Phase 9 calibration output (mb-dev log-gestures) — session data, not source
calibration-*.csv
session.csv
# Feature B conflict captures (mb-dev log-conflicts) — session data, not source
conflicts-*.csv

# Release output (dist/ holds the signed .app + DMG; regenerated by scripts/release.sh)
dist/

# Sparkle update staging (versioned DMGs + signed appcast.xml). Local mirror of the
# Codeberg Pages site; published by syncing its contents there (docs/14 §Sparkle).
updates/
