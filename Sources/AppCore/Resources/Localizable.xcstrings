{
  "sourceLanguage" : "en",
  "strings" : {
    "Accessibility" : {
      "comment" : "Name of the System Settings privacy pane the app needs.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accesibilidad"
          }
        }
      }
    },
    "Device Control and Data Access" : {
      "comment" : "Name of the System Settings privacy pane the app needs, on macOS 27 and later. Must match Apple's own wording for that pane.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Control de dispositivos y acceso a datos"
          }
        }
      }
    },
    "Enable MagicButtons under Accessibility." : {
      "comment" : "What to do once the deep link opens System Settings. 'MagicButtons' is the app name — do not translate.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa MagicButtons en Accesibilidad."
          }
        }
      }
    },
    "Enable MagicButtons under Device Control and Data Access." : {
      "comment" : "What to do once the deep link opens System Settings, on macOS 27 and later. The pane name must match Apple's. 'MagicButtons' is the app name — do not translate.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa MagicButtons en Control de dispositivos y acceso a datos."
          }
        }
      }
    },
    "Granted" : {
      "comment" : "VoiceOver label for the Status pane icon of a granted permission.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concedido"
          }
        }
      }
    },
    "Not granted" : {
      "comment" : "VoiceOver label for the Status pane icon of a permission not yet granted.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No concedido"
          }
        }
      }
    },
    "Post synthesized mouse-button clicks." : {
      "comment" : "Why the app needs Accessibility; shown under a granted permission.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviar clics sintetizados de los botones del ratón."
          }
        }
      }
    }
